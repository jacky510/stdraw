# 金标准基模 · 增长与投资不足 Growth and Underinvestment
# 出处：Senge 1990《第五项修炼》第 7 章 / Kim 1998《Systems Archetype Basics》Growth and Underinvestment（公有领域结构）
# 结构：6 节点 / 8 边 / 3 环（1 增强 + 2 平衡）；在「增长极限」之上加一条带延迟的产能补齐环
# 回路人工核对（沿箭头读一遍极性）：
#   R1 增长引擎：努力 +> 绩效 +> 努力 —— 全同向 = 增强（R）
#   B2 增长受限：绩效 +> 制约 -> 绩效 —— 一条负向 = 平衡（B）
#   B3 产能补齐：制约 +> 投资需求 +> 产能投资 +> 产能 -> 制约 —— 一条负向 = 平衡（B，带延迟；投资跟不上则 B2 主导）
graph "growth-and-underinvestment"
var efforts "努力"
var performance "绩效"
var limit "制约"
var need "投资需求"
var invest "产能投资"
var capacity "产能"

efforts -> + performance @loops R1
performance -> + efforts @loops R1
performance -> + limit @loops B2
limit -> - performance @loops B2
limit -> + need @loops B3
need -> + invest @loops B3
invest -> + capacity @loops B3
capacity -> - limit @loops B3

loop R1 "增长引擎" "R" [efforts, performance]
loop B2 "增长受限" "B" [performance, limit]
loop B3 "产能补齐" "B" [limit, need, invest, capacity]
